{
  "name": "emp-surveillance-backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node server.js && node ./core/v1/jobs/utils/worker.js",
    "dev": "node ./views/swagger.config.js && nodemon server.js",
    "dev:v2": "node ./views/swagger.config.js && node ./views/swagger-v2.config.js && nodemon server.js",
    "swagger": "node ./views/swagger.config.js",
    "swagger:v2": "node ./views/swagger-v2.config.js",
    "swagger:all": "node ./views/swagger.config.js && node ./views/swagger-v2.config.js",
    "production": "node bootstrap.js",
    "build": "npm run obfuscate && npm run encrypt",
    "obfuscate": "node ./scripts/copy_for_obfuscation.js && javascript-obfuscator obf_src --output dist --config ./obfuscator-strong.json",
    "encrypt": "node scripts/encrypt.js",
    "clone:incidents": "node scripts/clone-incidents-by-type.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@sendgrid/mail": "^8.1.5",
    "archiver": "^8.0.0",
    "async-mutex": "^0.5.0",
    "axios": "^1.9.0",
    "bullmq": "^5.67.2",
    "compression": "^1.8.0",
    "config": "^4.4.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "digest-fetch": "^3.1.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-basic-auth": "^1.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-xss-sanitizer": "^2.0.1",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^155.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "javascript-obfuscator": "^4.1.1",
    "joi": "^18.2.1",
    "js-base64": "^3.7.8",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "mongodb": "^6.20.0",
    "mongoose": "^8.13.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nanoid": "^5.1.6",
    "nodemon": "^3.1.9",
    "pdfkit": "^0.17.2",
    "prom-client": "^15.1.0",
    "socket.io": "^4.8.1",
    "ssh2-sftp-client": "^12.0.1",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.6.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xml2js": "^0.6.2",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^4.1.10",
    "copy-webpack-plugin": "^13.0.1",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.0.0",
    "vitest": "^2.1.9",
    "webpack": "^5.103.0",
    "webpack-cli": "^7.0.2",
    "webpack-node-externals": "^3.0.0",
    "webpack-obfuscator": "^3.5.1"
  }
}
