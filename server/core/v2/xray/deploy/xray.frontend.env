# ---------------------------------------------------------------------------
# X-ray mode -- frontend (videoraiq/client_v2/.env)
#
# ONE line to add. VITE_* are read at BUILD time, so this needs a rebuild of
# the frontend bundle, not a restart.
# ---------------------------------------------------------------------------

VITE_XRAY_ENABLED=true

# With it false or absent, the X-Ray button is not rendered and the module is
# never imported -- the off build is byte-identical bar one env string.
#
# Everything else the feature needs is already in the dev .env; it uses
# VITE_BACKEND for both REST and socket.io. Make sure the dev build has dev's
# own value, NOT a localhost one:
#   VITE_BACKEND=https://dev-api.videoraiq.com/api/v2
