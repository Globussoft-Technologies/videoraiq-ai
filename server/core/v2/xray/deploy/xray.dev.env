# ---------------------------------------------------------------------------
# X-ray mode -- Node backend (videoraiq/server)
#
# Env-var form of the `xray` config block. Env WINS over config/<env>.json, so
# these are enough on their own; use them if you would rather not re-encrypt
# the config file (`npm run encrypt` needs MK).
#
# Nothing here is a secret as shipped: fill in the two <PLACEHOLDER> values.
# ---------------------------------------------------------------------------

# The master flag. False => /api/v2/xray/* is not mounted (404), no WebSocket
# listener binds, and the Mongoose model is never compiled. Off is
# byte-identical to a build without X-ray.
XRAY_ENABLED=true

# The Python xray_service's base URL.
#
# LEAVE THIS EMPTY UNTIL THAT SERVICE IS DEPLOYED. Measured, both ways:
#   empty        -> POST /sessions answers in 88ms:  503 service_unavailable,
#                   "X-ray is not configured", retryable FALSE, and the boot
#                   log names XRAY_SERVICE_URL as the missing variable.
#   a dead host  -> 112ms on a refused connection, retryable TRUE -- and if the
#                   hostname does not RESOLVE, each press can stall up to
#                   XRAY_SERVICE_TIMEOUT_MS (15s) waiting on DNS.
# Empty is the honest state and the fast one. Set it when the service exists:
#   XRAY_SERVICE_URL=http://<gpu-box>:7910
XRAY_SERVICE_URL=

# Both credentials are sent on every call to that service, and BOTH must match
# the service's own values (XRAY_API_KEY and JWT_SECRET_KEY on the Python side).
# A mismatch surfaces to the browser as a 401, which reads as the USER being
# unauthorised -- so generate these once and set them in both places.
XRAY_API_KEY=<SHARED_SERVICE_KEY>
XRAY_JWT_SECRET=<SHARED_JWT_SECRET>

# The licence gate. "auto" enforces it wherever platform licensing is on, and
# the xRayMode allocation row CANNOT be created by any UI today (see README).
# "off" until that is resolved, or every POST /sessions is 403 not_licensed.
XRAY_LICENSE_CHECK=off

# The WebSocket the Python service dials IN to. It shares the API port, so
# there is no port to open or forward; the service is configured with
# ws://<node-host>:<api-port>/internal/xray/ws on its side.
XRAY_WS_PATH=/internal/xray/ws

# How long a session id may be unknown to this process before an inbound frame
# is taken as proof the session is gone. Covers the window between the
# service's 200 and this backend's Mongo write -- and, with more than one Node
# process, the case where the WebSocket and POST /sessions land on different
# ones. Do not set this to 0.
XRAY_WS_UNKNOWN_GRACE_MS=3000

# Reaping and timeouts. Both ends reap (contract section 10): Node on socket
# disconnect and stale heartbeat, the service on missing heartbeats.
XRAY_IDLE_TIMEOUT_SEC=45
XRAY_REAP_INTERVAL_SEC=15
XRAY_CLOSE_MAX_ATTEMPTS=5
XRAY_SERVICE_TIMEOUT_MS=15000
XRAY_JWT_TTL_SEC=120
XRAY_WS_PING_SEC=20
