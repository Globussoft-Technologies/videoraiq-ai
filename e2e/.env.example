# --- Target environment ---
# Dev environment: all three services live on host 80.225.251.2 behind these domains.
BASE_URL=https://dev.videoraiq.com
BACKEND_URL=https://dev-api.videoraiq.com
STREAMING_URL=https://dev-stream.videoraiq.com

# --- Credentials (do NOT commit real values) ---
# A test user provisioned in the dev environment.
TEST_USERNAME=
TEST_PASSWORD=

# Optional: a second user for permission / RBAC scenarios.
TEST_USERNAME_READONLY=
TEST_PASSWORD_READONLY=

# --- Cookie name ---
# Must match the cookie set by AdminLoginForm based on VITE_ENV.
# Dev deployment uses dev-access-token; prod uses prod-access-token; local uses access-token.
AUTH_COOKIE_NAME=dev-access-token

# --- Login route ---
# The deployed dev site exposes /login as the entry point; the React routes
# also include /admin-login and /user-login. Override here if needed.
LOGIN_PATH=/login

# --- Behavior toggles ---
# Set to "true" to run flows that mutate data (create NVR, register user, etc.).
# Default is read-only / smoke tests.
ALLOW_DESTRUCTIVE_TESTS=false

# Optional: slow tests down for local debugging.
SLOWMO_MS=0
