# Incident web push (Firebase Cloud Messaging). Leave empty to disable.
# Firebase console > Project settings > General > Your apps > Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase console > Project settings > Cloud Messaging > Web Push certificates > Key pair.
VITE_FIREBASE_VAPID_KEY=

# X-ray mode (docs/xray/00_CONTRACT.md §3). Default OFF — only the exact string
# "true" enables it. Off must be byte-identical to a build without the feature:
# the pill is not rendered and the module is never imported.
VITE_XRAY_ENABLED=false
